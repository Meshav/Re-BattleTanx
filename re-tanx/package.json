{
  "name": "re-tanx",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @re-tanx/client",
    "server": "npm run dev -w @re-tanx/server",
    "build": "npm run build -w @re-tanx/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim && tsc -p packages/client --noEmit && tsc -p packages/server --noEmit",
    "rules": "node scripts/check-rules.mjs && node scripts/check-ip.mjs",
    "check": "npm run rules && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
